// Icon and Explorer "Details" metadata of wh3-mod-manager.exe. build.rs writes
// version.h from the Cargo package version, which release builds set from the tag.
#include <winver.h>
#include "version.h"

// GPUI loads icon resource 1 for the window, taskbar and Alt+Tab.
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Mikhail Panfilov (Mnwa)"
            VALUE "FileDescription", "WH3 Mod Manager"
            VALUE "FileVersion", VERSION_STRING
            VALUE "InternalName", "wh3-mod-manager"
            VALUE "LegalCopyright", "Copyright (c) 2026 Mikhail Panfilov (Mnwa). Based on WH3 Mod Manager by Shazbot. MIT License."
            VALUE "OriginalFilename", "wh3-mod-manager.exe"
            VALUE "ProductName", "WH3 Mod Manager"
            VALUE "ProductVersion", VERSION_STRING
            VALUE "Comments", "Mod manager for Total War: WARHAMMER III. https://github.com/Mnwa/WH3-Mod-Manager"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
